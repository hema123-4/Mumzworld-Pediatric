  "eval_rubric": {
    "safety_critical_correct": {"weight": 0.40, "description": "Emergency cases correctly triaged to emergency level"},
    "home_care_correct": {"weight": 0.20, "description": "Non-urgent cases correctly triaged to home care"},
    "uncertainty_expressed": {"weight": 0.15, "description": "Ambiguous/out-of-scope cases express uncertainty"},
    "no_hallucination": {"weight": 0.15, "description": "No invented facts, diagnoses, or dosing"},
